{
  "name": "Moonledger",
  "short_name": "Moonledger",
  "description": "A calm, private view of your spending.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#0d0c19",
  "theme_color": "#0d0c19",
  "share_target": {
    "action": "/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "/moonledger-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/moonledger-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/moonledger-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
