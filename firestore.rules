rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isGoogleOwner(userId) {
      return request.auth != null
        && request.auth.uid == userId;
    }

    function validExpense() {
      return request.resource.data.keys().hasOnly([
          'amount', 'method', 'category', 'note', 'date', 'importedFromPrototype'
        ])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.method in ['UPI', 'Cash', 'Card']
        && request.resource.data.category in [
          'Food & drink', 'Food delivery', 'Groceries', 'Commute', 'Rent', 'Subscriptions', 'Going out',
          'Travel', 'Shopping', 'Bills', 'Health', 'Home', 'Entertainment', 'Other'
        ]
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 80
        && request.resource.data.date is string;
    }

    function validBudget() {
      return request.resource.data.keys().hasOnly(['amount', 'updatedAt'])
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.updatedAt is string;
    }

    function isSignedInGoogleGmail() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.matches('^[^@]+@gmail[.]com$');
    }

    function canUseCircle(circleId) {
      return isSignedInGoogleGmail();
    }

    function isCircleMember(circleId) {
      return isSignedInGoogleGmail()
        && canUseCircle(circleId)
        && exists(/databases/$(database)/documents/challenges/$(circleId)/members/$(request.auth.uid));
    }

    function inviteRateLimitAdvanced() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/inviteRateLimits/circles;
      return existsAfter(path)
        && getAfter(path).data.updatedAt == request.time
        && getAfter(path).data.count is int
        && getAfter(path).data.count > 0
        && getAfter(path).data.count <= 10
        && (exists(path)
          ? ((request.time < get(path).data.windowStartedAt + duration.value(24, 'h')
              && getAfter(path).data.count == get(path).data.count + 1
              && getAfter(path).data.windowStartedAt == get(path).data.windowStartedAt)
            || (request.time >= get(path).data.windowStartedAt + duration.value(24, 'h')
              && getAfter(path).data.count == 1
              && getAfter(path).data.windowStartedAt == request.time))
          : getAfter(path).data.count == 1 && getAfter(path).data.windowStartedAt == request.time);
    }

    function validCircleMember(circleId, memberId) {
      return isSignedInGoogleGmail()
        && request.auth.uid == memberId
        && canUseCircle(circleId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'inviteCode', 'joinedAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.inviteCode is string
        && request.resource.data.joinedAt is string
        && existsAfter(/databases/$(database)/documents/challengeInvites/$(request.resource.data.inviteCode))
        && getAfter(/databases/$(database)/documents/challengeInvites/$(request.resource.data.inviteCode)).data.challengeId == circleId;
    }

    function validCircleSummary(circleId, memberId, monthId) {
      return isSignedInGoogleGmail()
        && request.auth.uid == memberId
        && request.resource.data.keys().hasOnly(['displayName', 'month', 'budget', 'spent', 'updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 40
        && request.resource.data.month == monthId
        && monthId.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.budget is number
        && request.resource.data.budget >= 0
        && request.resource.data.spent is number
        && request.resource.data.spent >= 0
        && request.resource.data.updatedAt is string
        && existsAfter(/databases/$(database)/documents/challenges/$(circleId)/members/$(memberId));
    }

    match /users/{userId} {
      allow read: if isGoogleOwner(userId);
      allow create, update, delete: if false;

      match /expenses/{expenseId} {
        allow read, delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId) && validExpense();
      }

      match /budgets/{monthId} {
        allow read, delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId) && validBudget();
      }

      match /challenges/{circleId} {
        allow read: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId)
          && canUseCircle(circleId)
          && request.resource.data.keys().hasOnly(['name', 'inviteCode', 'joinedAt'])
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 40
          && request.resource.data.inviteCode is string
          && request.resource.data.joinedAt is string;
        allow delete: if isGoogleOwner(userId);
      }

      match /circleAccess/{slotId} {
        allow read: if isGoogleOwner(userId);
        allow create: if isGoogleOwner(userId)
          && slotId == 'freeSlot'
          && request.resource.data.keys().hasOnly(['circleId', 'createdAt'])
          && request.resource.data.circleId is string
          && request.resource.data.createdAt is string
          && existsAfter(/databases/$(database)/documents/challenges/$(request.resource.data.circleId)/members/$(userId));
        allow update, delete: if false;
      }

      match /recurring/{itemId} {
        allow read, delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId)
          && request.resource.data.keys().hasOnly(['name', 'amount', 'dueDay', 'kind', 'enabled', 'lastReminderKey'])
          && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 50
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
          && request.resource.data.dueDay is int && request.resource.data.dueDay >= 1 && request.resource.data.dueDay <= 31
          && request.resource.data.kind in ['bill', 'subscription']
          && request.resource.data.enabled is bool
          && (!('lastReminderKey' in request.resource.data) || request.resource.data.lastReminderKey is string);
      }

      match /debts/{debtId} {
        allow read: if isGoogleOwner(userId);
        allow delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId)
          && request.resource.data.keys().hasOnly(['person', 'amount', 'note', 'direction', 'settled', 'createdAt', 'splitId'])
          && request.resource.data.person is string && request.resource.data.person.size() > 0 && request.resource.data.person.size() <= 50
          && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 100000000
          && request.resource.data.note is string && request.resource.data.note.size() <= 80
          && request.resource.data.direction in ['owed-to-me', 'i-owe']
          && request.resource.data.settled is bool
          && request.resource.data.createdAt is string
          && (!('splitId' in request.resource.data) || (request.resource.data.splitId is string && request.resource.data.splitId.size() <= 100));
      }

      match /noSpendDays/{dayId} {
        allow read: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId)
          && request.resource.data.keys().hasOnly(['date'])
          && request.resource.data.date == dayId
          && dayId.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
        allow update: if false;
        allow delete: if isGoogleOwner(userId);
      }

      match /notificationTokens/{tokenId} {
        allow read, delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId)
          && request.resource.data.keys().hasOnly(['token', 'userId', 'timezone', 'eveningEnabled', 'lastEveningDate', 'updatedAt'])
          && request.resource.data.token is string && request.resource.data.token.size() > 0 && request.resource.data.token.size() <= 4096
          && request.resource.data.userId == userId
          && request.resource.data.timezone is string && request.resource.data.timezone.size() <= 80
          && request.resource.data.eveningEnabled is bool
          && request.resource.data.lastEveningDate is string
          && request.resource.data.updatedAt is string;
      }

      match /inviteRateLimits/{limitId} {
        allow read: if isGoogleOwner(userId);
        allow create: if isGoogleOwner(userId) && limitId == 'circles'
          && request.resource.data.keys().hasOnly(['count', 'windowStartedAt', 'updatedAt'])
          && request.resource.data.count == 1
          && request.resource.data.windowStartedAt == request.time
          && request.resource.data.updatedAt == request.time;
        allow update: if isGoogleOwner(userId) && limitId == 'circles'
          && request.resource.data.keys().hasOnly(['count', 'windowStartedAt', 'updatedAt'])
          && request.resource.data.updatedAt == request.time
          && ((request.time < resource.data.windowStartedAt + duration.value(24, 'h')
              && request.resource.data.count == resource.data.count + 1
              && request.resource.data.windowStartedAt == resource.data.windowStartedAt
              && request.resource.data.count <= 10)
            || (request.time >= resource.data.windowStartedAt + duration.value(24, 'h')
              && request.resource.data.count == 1
              && request.resource.data.windowStartedAt == request.time));
        allow delete: if false;
      }

      match /challengeProgress/{progressId} {
        allow read, delete: if isGoogleOwner(userId);
        allow create, update: if isGoogleOwner(userId) && progressId == 'no-spend-7'
          && request.resource.data.keys().hasOnly(['type', 'startDate'])
          && request.resource.data.type == 'no-spend-7'
          && request.resource.data.startDate is string
          && request.resource.data.startDate.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
      }

      match /entitlements/{entitlementId} { allow read, write: if false; }
    }

    match /challengeInvites/{inviteCode} {
      allow get: if isSignedInGoogleGmail();
      allow list: if false;
      allow create: if isSignedInGoogleGmail()
        && request.resource.data.challengeId is string
        && canUseCircle(request.resource.data.challengeId)
        && request.resource.data.keys().hasOnly(['challengeId', 'name', 'createdBy'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 40
        && request.resource.data.createdBy == request.auth.uid
        && inviteRateLimitAdvanced()
        && inviteCode.matches('^[A-F0-9]{32}$')
        && getAfter(/databases/$(database)/documents/challenges/$(request.resource.data.challengeId)).data.ownerId == request.auth.uid;
      allow update, delete: if isSignedInGoogleGmail()
        && resource.data.createdBy == request.auth.uid;
    }

    match /accessCodes/{code} { allow read, write: if false; }

    match /challenges/{circleId} {
      allow create: if isSignedInGoogleGmail()
        && request.resource.data.keys().hasOnly(['name', 'ownerId', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 40
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.createdAt is string;
      allow read: if isCircleMember(circleId);
      allow update, delete: if isSignedInGoogleGmail() && resource.data.ownerId == request.auth.uid;

      match /members/{memberId} {
        allow read: if isCircleMember(circleId);
        allow create: if validCircleMember(circleId, memberId);
        allow update: if isCircleMember(circleId) && request.auth.uid == memberId && validCircleMember(circleId, memberId);
        allow delete: if isCircleMember(circleId) && request.auth.uid == memberId;
      }

      match /months/{monthId}/members/{memberId} {
        allow read: if isCircleMember(circleId);
        allow create, update: if validCircleSummary(circleId, memberId, monthId);
        allow delete: if isCircleMember(circleId) && request.auth.uid == memberId;
      }

      match /splits/{splitId} {
        allow read: if isCircleMember(circleId);
        allow create: if isCircleMember(circleId)
          && request.resource.data.keys().hasOnly(['title', 'total', 'participantCount', 'createdBy', 'createdByName', 'createdAt'])
          && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 60
          && request.resource.data.total is number && request.resource.data.total > 0 && request.resource.data.total <= 100000000
          && request.resource.data.participantCount is int && request.resource.data.participantCount >= 2 && request.resource.data.participantCount <= 20
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.createdByName is string && request.resource.data.createdByName.size() <= 40
          && request.resource.data.createdAt is string;
        allow update: if false;
        allow delete: if isCircleMember(circleId) && resource.data.createdBy == request.auth.uid;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
